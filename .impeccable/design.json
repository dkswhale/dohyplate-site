      "css": ".ds-facts{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none} .ds-facts li{display:inline-flex;align-items:center;min-height:36px;border:2px solid var(--line,#dce1ea);padding:0 10px;font-size:15px;color:var(--muted,#535d70);font-family:system-ui,sans-serif} .ds-facts .ds-tag{padding:0 12px;border:2px solid var(--ink,#191f2c);background:#ffc93c;color:#191f2c;font-family:'Galmuri11','Apple SD Gothic Neo',sans-serif;font-weight:700;font-size:22px;line-height:1} .ds-facts .ds-soon{background:transparent;color:var(--muted,#535d70);border:2px dashed var(--x,#aab2c0)}"
    },
    {
      "name": "게임 카드",
      "kind": "card",
      "description": "문제 번호 제목, 사실 칩, 그림 칸.",
      "html": "<article class=\"ds-game\"><div class=\"ds-gi\"><h3><span>No.1</span> 픽셀 벨트</h3><p>벨트에 캐릭터를 태워 보내는 퍼즐 게임이에요.</p></div><div class=\"ds-ga\"></div></article>",
      "css": ".ds-game{display:grid;grid-template-columns:1fr 1fr;border:3px solid var(--ink,#191f2c);background:var(--paper,#fff)} .ds-gi{padding:36px;display:flex;flex-direction:column;gap:16px} .ds-gi h3{margin:0;font-family:'Galmuri11','Apple SD Gothic Neo',sans-serif;font-size:44px;line-height:1.2;color:var(--ink,#191f2c)} .ds-gi h3 span{color:var(--text-y,#8a5a00)} .ds-gi p{margin:0;font-family:system-ui,sans-serif;font-size:17px;line-height:1.7} .ds-ga{border-left:3px solid var(--ink,#191f2c);background:var(--grid,#eef1f5);min-height:160px}"
    },
    {
      "name": "메일 칸",
      "kind": "custom",
      "refersTo": "mail-cell",
      "description": "메일 주소가 큰 칸.",
      "html": "<a class=\"ds-mail\" href=\"#\">ramon@dohyplate.com</a>",
      "css": ".ds-mail{display:inline-flex;align-items:center;padding:18px 24px;border:3px solid var(--ink,#191f2c);background:var(--paper,#fff);font-family:'Galmuri11','Apple SD Gothic Neo',sans-serif;font-weight:700;font-size:33px;line-height:1.2;color:var(--ink,#191f2c);text-decoration:none;transition:background-color .15s ease-out} .ds-mail:hover{background:#ffc93c;color:#191f2c} .ds-mail:focus-visible{outline:3px solid var(--ink,#191f2c);outline-offset:3px}"
    },
    {
      "name": "네모로직 격자",
      "kind": "custom",
      "description": "힌트 숫자와 5칸 기준선이 있는 격자 (puzzle.js 출력의 축소판).",
      "html": "<div class=\"ds-pz\"><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f r\"></i><i class=\"x\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f r\"></i><i class=\"x\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f r\"></i><i class=\"x\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f r\"></i><i class=\"x\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f\"></i><i class=\"f r\"></i><i class=\"x\"></i><i class=\"x\"></i><i class=\"x\"></i><i class=\"x\"></i><i class=\"x\"></i><i class=\"x r\"></i><i class=\"x\"></i></div>",
      "css": ".ds-pz{display:grid;grid-template-columns:repeat(6,30px);grid-auto-rows:30px;border:3px solid var(--ink,#191f2c);background:var(--paper,#fff);width:max-content} .ds-pz i{position:relative;border-right:1px solid var(--line,#dce1ea);border-bottom:1px solid var(--line,#dce1ea)} .ds-pz i.r{border-right:2px solid var(--guide,#7d8698)} .ds-pz i.f{background:#ffc93c} .ds-pz i.x::before{content:'';position:absolute;inset:26%;background:linear-gradient(45deg,transparent calc(50% - 1px),var(--x,#aab2c0) calc(50% - 1px),var(--x,#aab2c0) calc(50% + 1px),transparent calc(50% + 1px)),linear-gradient(-45deg,transparent calc(50% - 1px),var(--x,#aab2c0) calc(50% - 1px),var(--x,#aab2c0) calc(50% + 1px),transparent calc(50% + 1px))}"
    }
